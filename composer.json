{
  "name": "lesname/hydrator",
  "license": "MIT",
  "require": {
    "php": "^8.5.0",

    "lesname/value-object": "^0.7.1"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "^4.0.0",
    "phpunit/phpunit": "^13.0.0",

    "vimeo/psalm": "^7.0.0-beta19",

    "phpstan/phpstan": "^2.0.0",
    "phpstan/extension-installer": "^1.4.0",
    "phpstan/phpstan-deprecation-rules": "^2.0.0"
  },
  "autoload": {
    "psr-4": {
      "LesHydrator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "LesHydratorTest\\": "test/"
    }
  },
  "config": {
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
